# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# dados do seu projeto Supabase: Project Settings > API.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA

# Chave usada para assinar o token JWT do login (mantém a sessão salva no
# navegador por 1 dia). Defina um valor aleatório e diferente em produção.
VITE_JWT_SECRET=troque-por-um-valor-aleatorio-e-secreto
